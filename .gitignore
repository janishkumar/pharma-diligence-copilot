# Secrets — never commit
.env

# OS junk
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/

# Generated data (reproducible via scripts/01_ingest.py and 02_index.py)
# Ignore contents but keep the directory structure via .gitkeep
data/raw/*
data/processed/*
data/finetune/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/finetune/.gitkeep
# The synthetic datasets cost real API money to regenerate and M7 needs them
# on the training box — keep them in the repo (public filing text only).
!data/finetune/train_v1.jsonl
!data/finetune/test_v1.jsonl
!data/finetune/test_v1_for_review.md
!data/finetune/gen_stats.json
.chroma/

# Models (large binaries; produced in Phase 2)
models/merged/*
models/gguf/*
!models/merged/.gitkeep
!models/gguf/.gitkeep

# Logs and run artifacts
logs/*
!logs/.gitkeep
finetune/runs/*
!finetune/runs/.gitkeep
eval/reports/*
!eval/reports/.gitkeep

# Lockfiles are generated on first build
requirements.lock
